# Your Boson API key. It stays in the worker; clients never see it.
BOSON_API_KEY=

# Your LiveKit Cloud project (cloud.livekit.io → Settings → Keys). Use Cloud,
# not livekit-server --dev: Higgs Avatar (Phase 4) refuses self-hosted servers.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. The model and voice default to shared/session.json.
# BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime/
# BOSON_REALTIME_MODEL=higgs-realtime
# BOSON_VOICE=eleanor
